{
  "name": "pocket-cube-state-explorer",
  "version": "0.1.0",
  "description": "Every state of the 2x2x2 Pocket Cube as a 3D graph, grown layer by layer from the solved cube.",
  "license": "MIT",
  "author": "Rafael Cordones",
  "repository": "github:rafacm/pocket-cube-state-explorer",
  "private": true,
  "type": "module",
  "dependencies": {
    "three": "0.147.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.4",
    "@types/three": "0.147.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.embed.config.ts",
    "preview": "vite preview",
    "test": "bun test tests",
    "typecheck": "tsc",
    "e2e": "playwright test",
    "screenshots": "bun run build && bun scripts/screenshots.ts"
  }
